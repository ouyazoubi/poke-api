{
  "name": "poke-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/setup-local.cjs && node scripts/start-local.mjs --dev",
    "build": "tsc -p tsconfig.json",
    "start": "node scripts/setup-local.cjs && node scripts/start-local.mjs",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test test/integration.ts",
    "start:external": "node dist/server.js"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
